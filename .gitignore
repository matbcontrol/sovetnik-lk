# окружение и служебное
.venv/
__pycache__/
*.pyc
.env
.env.*
!.env.example

# сырые данные обхода и данные организаторов в репозиторий не кладём
data/raw/
data/private/

# Промежуточные данные: открытые файлы каталога, журнал расхода модели и прогоны агента лежат в репозитории,
# чтобы замеры и стенд воспроизводились без многочасового обхода магазина. Не публикуются служебные журналы
# и кеш ответов модели. По API уходили только названия и описания из открытого каталога (журнал — llm_calls.jsonl).
data/interim/*
!data/interim/feed_offers.jsonl.gz
!data/interim/feed_categories.csv
!data/interim/sitemap_urls.csv
!data/interim/category_listing.jsonl
!data/interim/families.jsonl
!data/interim/arpp_replacements.csv
!data/interim/graph_nodes.csv
!data/interim/graph_edges.csv
!data/interim/class_names.json
!data/interim/class_rank.json
!data/interim/class_links.csv
!data/interim/llm_calls.jsonl
!data/interim/agent_runs/
!data/interim/agent_runs_nohints/

# локальные базы и кеши
*.sqlite
*.db
.cache/
.claude/

# отчёты на искусственных данных — только проверка счёта, не результат
reports/*synthetic*

# клиенты и советы на данных организаторов — не публикуются
site/data/private*.json

# скачанный шаблон организаторов: в репозиторий идёт только заполненный файл
submission/template/
