# окружение и служебное
.venv/
__pycache__/
*.pyc
.env
.env.*
!.env.example

# сырые и промежуточные данные (собираются скриптами, в репозиторий не кладём)
data/raw/
data/interim/
data/private/

# локальные базы и кеши
*.sqlite
*.db
.cache/
.claude/

# отчёты на искусственных данных — только проверка счёта, не результат
reports/*synthetic*

# клиенты и советы на данных организаторов — не публикуются
site/data/private*.json
