# Скопируйте этот файл в .env и впишите свои значения. Файл .env в репозиторий не попадает.
# Модель нужна только для разовой разметки каталога (классы и связи классов).
# На запрос клиента модель не вызывается: выдача идёт по готовому графу.

# Поставщик модели: google (Google AI Studio) или openai_compatible (например, Yandex AI Studio)
LLM_PROVIDER=google
LLM_MODEL=
# запасные модели через запятую: берутся по очереди, когда у основной исчерпан суточный лимит
LLM_MODELS=
GOOGLE_API_KEY=

# Для openai_compatible:
LLM_BASE_URL=
LLM_API_KEY=
