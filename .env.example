# Скопируйте этот файл в .env и впишите свои значения. Файл .env в репозиторий не попадает.
# Модель нужна только для разовой разметки каталога (классы и связи классов) и для агента каталога.
# На запрос клиента модель не вызывается: выдача идёт по готовому графу.

# Поставщик модели: google (Google AI Studio) или openai_compatible (DeepSeek, Alibaba Model Studio, Yandex AI Studio)
LLM_PROVIDER=google
LLM_MODEL=
# запасные модели через запятую: берутся по очереди, когда у основной исчерпан суточный лимит
LLM_MODELS=
GOOGLE_API_KEY=

# Для openai_compatible. Пример для DeepSeek:
#   LLM_PROVIDER=openai_compatible
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-v4-pro
LLM_BASE_URL=
LLM_API_KEY=
# Режим рассуждений совместимого сервиса: off (по умолчанию) — выключить, on — включить, auto — как решит сервис.
# С рассуждением ответ идёт в разы дольше, а само рассуждение оплачивается как выход.
LLM_THINKING=off
# Усилие рассуждений, если сервис его знает: low, high или max. Пусто — как у сервиса по умолчанию.
LLM_EFFORT=
